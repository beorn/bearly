{
  "name": "bearly",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable Claude Code tools — coordination, testing, research, refactoring",
  "keywords": [
    "ai",
    "batch-refactor",
    "claude-code",
    "codemod",
    "developer-tools",
    "gemini",
    "gpt",
    "llm",
    "multi-llm",
    "refactoring",
    "session-search",
    "ts-morph",
    "tty",
    "worktree"
  ],
  "license": "MIT",
  "author": "Beorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "files": [
    "tools",
    "skills"
  ],
  "type": "module",
  "exports": {
    "./tools/worktree": "./tools/worktree.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "refactor": "bun tools/refactor.ts",
    "llm": "bun tools/llm.ts",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "fix": "oxfmt --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/openai-compatible": "3.0.62",
    "@ai-sdk/perplexity": "5.0.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@silvery/commander": "^0.19.2",
    "@termless/core": "^0.6.0",
    "@termless/xtermjs": "^0.3.1",
    "ai": "7.0.126",
    "commander": "^15.0.0",
    "git-super": "^0.1.0",
    "loggily": "^0.10.2",
    "openai": "^6.46.0",
    "removely": "workspace:*",
    "ts-morph": "28.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.38.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=23.6.0"
  }
}
