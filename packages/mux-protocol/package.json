{
  "name": "@bearly/mux-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-agnostic multiplexer interface (MuxBackend) + capability-adaptive contract suite. Lets a coordinator drive agent panes over cmux / tmux / silvermux without knowing the backend. Sibling to @bearly/mux-cmux-adapter.",
  "keywords": [
    "agent-pane",
    "cmux",
    "contract-test",
    "multiplexer",
    "mux",
    "silvermux",
    "tmux"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/mux-protocol",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing/contract-cases": "./src/testing/contract-cases.ts",
    "./testing/in-memory-mux": "./src/testing/in-memory-mux.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./testing/contract-cases": {
        "types": "./dist/testing/contract-cases.d.mts",
        "import": "./dist/testing/contract-cases.mjs"
      },
      "./testing/in-memory-mux": {
        "types": "./dist/testing/in-memory-mux.d.mts",
        "import": "./dist/testing/in-memory-mux.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "tsdown": "0.22.13",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/testing/contract-cases.ts",
      "src/testing/in-memory-mux.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
