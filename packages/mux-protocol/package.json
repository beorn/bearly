{
  "name": "@bearly/mux-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-agnostic multiplexer interface (MuxBackend) + capability-adaptive contract suite. Lets a coordinator drive agent panes over cmux / tmux / silvermux without knowing the backend. Sibling to @bearly/mux-cmux-adapter.",
  "keywords": [
    "agent-pane",
    "cmux",
    "contract-test",
    "multiplexer",
    "mux",
    "silvermux",
    "tmux"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/mux-protocol",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "import": "./dist/contract.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/contract.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
