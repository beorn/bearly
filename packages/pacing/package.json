{
  "name": "@bearly/pacing",
  "version": "0.3.0",
  "description": "Pure duration parsing and pacing policy: jitter and readiness",
  "keywords": [
    "backoff",
    "duration",
    "jitter",
    "readiness",
    "retry",
    "thundering-herd"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/pacing",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git",
    "directory": "packages/pacing"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "src/index.ts",
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
