{
  "name": "@bearly/pacing",
  "version": "0.1.0",
  "description": "Pure pacing policy: full and decorrelated jitter, a readiness gate, a rolling max-unavailable budget",
  "keywords": [
    "backoff",
    "jitter",
    "readiness",
    "retry",
    "thundering-herd"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/pacing",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git",
    "directory": "packages/pacing"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "tsdown": "^0.22.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "src/index.ts",
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
