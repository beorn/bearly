{
  "name": "@bearly/mux-cmux-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "cmux backend for @bearly/mux-protocol — wraps the cmux CLI behind the MuxBackend interface, no behavior change. The seam that lets tent/chief talk to a mux instead of shelling out to cmux.",
  "keywords": [
    "adapter",
    "agent-pane",
    "cmux",
    "multiplexer",
    "mux"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/mux-cmux-adapter",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@bearly/mux-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "tsdown": "^0.22.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "src/index.ts",
    "format": "esm"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
