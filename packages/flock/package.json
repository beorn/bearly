{
  "name": "@bearly/flock",
  "version": "0.2.3",
  "description": "Crash-safe fd-held flock ownership for Bun on local macOS and Linux filesystems",
  "keywords": [
    "advisory-lock",
    "bun",
    "file-lock",
    "flock",
    "linux",
    "macos"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/flock",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git",
    "directory": "packages/flock"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./holders": "./src/holders.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./holders": {
        "types": "./dist/holders.d.mts",
        "import": "./dist/holders.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/ffi-drift",
    "prepublishOnly": "bun run build",
    "test:node": "FLOCK_TEST_RUNTIME=node vitest run"
  },
  "dependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "tsdown": {
    "clean": true,
    "deps": {
      "neverBundle": [
        "bun:ffi",
        "koffi"
      ]
    },
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/holders.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=24"
  }
}
