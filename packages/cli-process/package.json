{
  "name": "@bearly/cli-process",
  "version": "0.1.0",
  "description": "A CLI entry that never loses its own output: drained exit, named EPIPE, console through the streams",
  "keywords": [
    "cli",
    "epipe",
    "pipe",
    "stdout",
    "truncation"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/cli-process",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git",
    "directory": "packages/cli-process"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "import": "./dist/testing.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "tsdown": "0.22.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/testing.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20"
  }
}
