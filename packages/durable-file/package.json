{
  "name": "@bearly/durable-file",
  "version": "0.1.0",
  "private": true,
  "description": "Crash-durable atomic files and strict verdict artifacts",
  "keywords": [
    "atomic-write",
    "durability",
    "fsync",
    "verdict"
  ],
  "homepage": "https://github.com/beorn/bearly/tree/main/packages/durable-file",
  "bugs": {
    "url": "https://github.com/beorn/bearly/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/bearly.git",
    "directory": "packages/durable-file"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./verdict": "./src/verdict.ts",
    "./cas": "./src/cas.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./verdict": {
        "types": "./dist/verdict.d.mts",
        "import": "./dist/verdict.mjs"
      },
      "./cas": {
        "types": "./dist/cas.d.mts",
        "import": "./dist/cas.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@bearly/flock": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "removely": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/verdict.ts",
      "src/cas.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
